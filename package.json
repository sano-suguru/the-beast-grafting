    "@vitest/coverage-v8": "^4.1.1",
    "dependency-cruiser": "^17.3.9",
    "drizzle-kit": "^0.31.10",
    "jscpd": "^4.0.8",
    "jsdom": "^29.0.1",
    "knip": "^6.0.3",
    "miniflare": "^4.20260405.0",
    "oxlint-plugin-eslint": "^1.57.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
