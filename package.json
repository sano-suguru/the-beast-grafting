    "preview": "vp preview",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "depcruise": "depcruise src --validate .dependency-cruiser.cjs",
    "similarity": "similarity-ts src/app src/shared src/engine --fail-on-duplicates --rename-cost 0.5 && similarity-ts src/worker src/db --fail-on-duplicates --rename-cost 0.5",
    "check": "vp check && vp test run && knip && jscpd src && similarity-ts src/app src/shared src/engine --fail-on-duplicates --rename-cost 0.5 && similarity-ts src/worker src/db --fail-on-duplicates --rename-cost 0.5 && depcruise src --validate .dependency-cruiser.cjs",
    "cpd": "jscpd src",
    "test": "vp test",
    "test:unit": "vp test run",
    "test:e2e": "playwright test",
    "test:coverage": "vp test run --coverage",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply beast-grafting-db --local"
  },
  "dependencies": {
    "@preact/signals": "^2.8.2",
    "drizzle-orm": "^0.45.1",
